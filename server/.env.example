NODE_ENV=development
PORT=8000
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173

# Optional TURN relay for restrictive public/school Wi-Fi.
# Coturn REST API shared secret must match TURN_SHARED_SECRET.
# Include TLS/TCP 443 and UDP/TCP 3478 endpoints where available.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=600
